/* styles/light.qss — 冷蓝专业 · 亮色控制台 */

QMainWindow, QDialog { background: #F3F5F8; color: #1E293B; font-family: "Microsoft YaHei UI", "微软雅黑", sans-serif; font-size: 13px; }
QStatusBar { background: #FFFFFF; color: #64748B; border-top: 1px solid #E2E8F0; min-height: 26px; }
QStatusBar QLabel { color: #64748B; padding-left: 8px; }
QToolBar { background: #FFFFFF; border: none; border-bottom: 1px solid #E2E8F0; padding: 8px 12px; spacing: 8px; }
QToolBar QLabel { color: #64748B; font-size: 12px; padding: 0 2px; }
QToolBar QPushButton { background: #EEF1F6; color: #1E293B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 7px 12px; font-size: 12px; min-height: 28px; }
QToolBar QPushButton#speedBtn { padding: 6px 10px; min-width: 40px; }
QToolBar QPushButton:hover { background: #E2E8F0; border-color: #2563EB; }
QToolBar QPushButton:pressed { background: #CBD5E1; }
QToolBar QPushButton:disabled { background: #F8FAFC; color: #94A3B8; border-color: #E2E8F0; }
QToolBar QPushButton:checked { background: #DBEAFE; color: #1D4ED8; border-color: #2563EB; }
QToolBar QComboBox { background: #FFFFFF; color: #1E293B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 6px 10px; min-width: 88px; min-height: 28px; }
QToolBar QComboBox:hover { border-color: #2563EB; }
QToolBar QComboBox::drop-down { border: none; width: 22px; }
QToolBar QComboBox QAbstractItemView { background: #FFFFFF; color: #1E293B; border: 1px solid #E2E8F0; selection-background-color: #2563EB; selection-color: white; outline: none; }
#extendBtn { background: #2563EB; color: white; border: 1px solid #2563EB; font-weight: 600; padding: 7px 16px; }
#extendBtn:hover { background: #1D4ED8; border-color: #1D4ED8; }
#extendBtn:pressed { background: #1E40AF; }
#topmostBtn { min-width: 52px; }
#navPanel { background: #FFFFFF; border-right: 1px solid #E2E8F0; }
#navPanel QLabel { color: #64748B; font-size: 12px; }
#bookGrid, #bookGridInner { background: #FFFFFF; border: none; }
#bookBtn { background: #EEF1F6; color: #1E293B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 8px 10px; font-size: 13px; text-align: center; }
#bookBtn:hover { background: #E2E8F0; border-color: #CBD5E1; }
#bookBtn:checked { background: #DBEAFE; color: #1E3A8A; border-color: #2563EB; }
QTabWidget::pane { border: none; background: #FFFFFF; top: -1px; }
QTabBar { qproperty-drawBase: false; min-height: 36px; }
QTabBar::tab { background: transparent; color: #64748B; padding: 9px 4px; font-size: 12px; border: none; border-bottom: 2px solid transparent; margin: 0; min-width: 48px; min-height: 32px; }
QTabBar::tab:hover { color: #1E293B; background: transparent; }
QTabBar::tab:selected { color: #2563EB; background: transparent; border-bottom: 2px solid #2563EB; font-weight: 600; }
QListWidget { background: #FFFFFF; border: none; color: #1E293B; font-size: 13px; outline: none; }
QListWidget::item { background: #EEF1F6; color: #1E293B; border: 1px solid transparent; border-radius: 6px; padding: 6px 8px; margin: 2px; }
QListWidget::item:hover { background: #E2E8F0; border-color: #CBD5E1; }
QListWidget::item:selected { background: #DBEAFE; color: #1E3A8A; border-color: #2563EB; }
#historyList { background: transparent; border: none; }
#historyListInner { background: transparent; }
#historyItem { background: #EEF1F6; border: 1px solid #E2E8F0; border-radius: 6px; }
#historyItem:hover { background: #E2E8F0; border-color: #CBD5E1; }
#historyItem[selected="true"] { background: #DBEAFE; border: 1px solid #2563EB; }
#historyText { font-size: 13px; color: #1E293B; background: transparent; }
#historyDeleteButton { background: transparent; color: #64748B; border: 1px solid #CBD5E1; border-radius: 5px; font-size: 12px; padding: 0; }
#historyDeleteButton:hover { background: #EF4444; color: white; border: 1px solid #EF4444; }
#historyDeleteButton:pressed { background: #DC2626; color: white; }

/* ===== 数字输入框：显式绘制上下箭头，避免系统样式导致箭头消失 ===== */
QSpinBox { background: #FFFFFF; color: #1E293B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 5px 8px; min-height: 26px; font-size: 13px; }
QSpinBox:hover, QSpinBox:focus { border-color: #2563EB; }
QSpinBox::up-button, QSpinBox::down-button { background: #EEF1F6; border: none; width: 20px; subcontrol-origin: border; }
QSpinBox::up-button { subcontrol-position: top right; }
QSpinBox::down-button { subcontrol-position: bottom right; }
QSpinBox::up-arrow, QSpinBox::down-arrow { width: 9px; height: 9px; }
QSpinBox::up-arrow { image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-bottom: 5px solid #475569; }
QSpinBox::down-arrow { image: none; border-left: 4px solid transparent; border-right: 4px solid transparent; border-top: 5px solid #475569; }
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background: #E2E8F0; }

#rangeBox { background: #F8FAFC; border-top: 1px solid #E2E8F0; }
#selectRangeBtn { background: #2563EB; color: white; border: none; border-radius: 6px; padding: 8px 12px; font-weight: 600; min-height: 30px; }
#selectRangeBtn:hover { background: #1D4ED8; }
#segmentBtn { background: #EEF1F6; color: #64748B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 6px 10px; text-align: left; }
#segmentBtn:checked { background: #DBEAFE; color: #1D4ED8; border-color: #2563EB; }
#clearHistoryBtn { background: transparent; color: #64748B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 8px; margin: 4px; }
#clearHistoryBtn:hover { background: #FEF2F2; color: #DC2626; border-color: #DC2626; }
QPushButton { background: #EEF1F6; color: #1E293B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 7px 14px; font-size: 12px; }
QPushButton:hover { background: #E2E8F0; border-color: #2563EB; }
QPushButton:pressed { background: #CBD5E1; }
QPushButton:disabled { color: #94A3B8; }
QGroupBox { color: #1E293B; border: 1px solid #E2E8F0; border-radius: 8px; margin-top: 12px; padding-top: 12px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 6px; color: #64748B; }
QComboBox, QFontComboBox { background: #FFFFFF; color: #1E293B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 5px 8px; min-height: 26px; }
QComboBox:hover, QFontComboBox:hover, QComboBox:focus, QFontComboBox:focus { border-color: #2563EB; }
QComboBox QAbstractItemView, QFontComboBox QAbstractItemView { background: #FFFFFF; color: #1E293B; border: 1px solid #E2E8F0; selection-background-color: #2563EB; selection-color: white; }
QLineEdit { background: #FFFFFF; color: #1E293B; border: 1px solid #E2E8F0; border-radius: 6px; padding: 7px 10px; font-size: 13px; min-width: 0; }
QLineEdit:focus { border-color: #2563EB; }
#searchInput { background: #FFFFFF; color: #1E293B; border: 2px solid #2563EB; border-radius: 10px; padding: 12px 16px; font-size: 15px; min-width: 360px; }
#searchInput:focus { border-color: #1D4ED8; }
QSplitter::handle { background: #E2E8F0; width: 1px; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #CBD5E1; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #94A3B8; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical, QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { height: 0; background: none; }
